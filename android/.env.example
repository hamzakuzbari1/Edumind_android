# Copy this file to .env for a shared/dev Android build.
# Local development is an explicit override: APP_ENV=local and API_BASE_URL=http://10.0.2.2:8000.
APP_ENV=shared
API_BASE_URL=https://eduspark-api-dev.onrender.com
AUTH_DATA_SOURCE_MODE=REMOTE
LEARNING_DATA_SOURCE_MODE=REMOTE
PROFILE_DATA_SOURCE_MODE=REMOTE
ACHIEVEMENT_DATA_SOURCE_MODE=REMOTE
TEACHER_NOTES_DATA_SOURCE_MODE=REMOTE
QUIZ_DATA_SOURCE_MODE=REMOTE
TEACHER_UPLOAD_DATA_SOURCE_MODE=REMOTE
MESSAGING_DATA_SOURCE_MODE=REMOTE
SUBSCRIPTION_DATA_SOURCE_MODE=REMOTE
PAYMENT_DATA_SOURCE_MODE=REMOTE
DATA_SOURCE_MODE=REMOTE
LANGUAGE_DATA_SOURCE_MODE=MOCK
TUTOR_DATA_SOURCE_MODE=MOCK
CERTIFICATE_DATA_SOURCE_MODE=MOCK
SECURITY_DATA_SOURCE_MODE=MOCK
PROJECT_DATA_SOURCE_MODE=MOCK
NOTIFICATION_DATA_SOURCE_MODE=MOCK
TEACHER_CORE_DATA_SOURCE_MODE=MOCK
PAYMENT_MODE=direct
PLANNER_DATA_SOURCE_MODE=REMOTE
ROUTINE_DATA_SOURCE_MODE=REMOTE
