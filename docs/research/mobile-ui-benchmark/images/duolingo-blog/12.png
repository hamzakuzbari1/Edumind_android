<!doctype html><html lang="ko"><head><meta charset="utf-8"><title>카카오 스토리</title><meta name="viewport" content="user-scalable=no,initial-scale=1,maximum-scale=1,minimum-scale=1,width=device-width"><meta name="format-detection" content="telephone=no"><style type="text/css">html{overflow-y:scroll;height:100%}body,div,dl,dt,dd,ul,ol,li,h1,h2,h3,h4,h5,h6,pre,code,form,fieldset,legend,textarea,p,blockquote,th,td,input,select,textarea,button{margin:0;padding:0}fieldset,img{border:0 none;vertical-align:top}dl,ul,ol,menu,li{list-style:none}blockquote,q{quotes:none}blockquote:before,blockquote:after,q:before,q:after{content:'';content:none}input,select,textarea,button{vertical-align:middle}input::-ms-clear{display:none}button{border:0 none;background-color:transparent;cursor:pointer}body{height:100%;background:#eaeaea}body,th,td,input,select,textarea,button{font-size:14px;font-family:Apple SD Gothic Neo,'Apple SD 산돌고딕 Neo',NanumGothic,'나눔고딕',ng,sans-serif;color:#333}a{color:#333;text-decoration:none}a:active,a:hover{text-decoration:underline}a:active{background-color:transparent}address,caption,cite,code,dfn,em,var{font-style:normal;font-weight:400}.ir_wa{display:block;overflow:hidden;position:relative;width:100%;height:100%;z-index:-1}.hide{display:none}.ico_ks{display:block;overflow:hidden;font-size:0;line-height:0;background:url(./ico_ks.png) no-repeat 0 0;text-indent:-9999px}.ico_error{display:block;overflow:hidden;font-size:0;line-height:0;background:url(./ico_error.png) no-repeat 0 0;text-indent:-9999px}@media only screen and (-webkit-min-device-pixel-ratio :1.5),only screen and (min-device-pixel-ratio :1.5){.ico_ks{background-image:url(./ico_ks_rtn.png);-webkit-background-size:500px 1000px;background-size:500px 1000px}.ico_error{background-image:url(./ico_error_rtn.png);-webkit-background-size:193px 480px;background-size:193px 480px}}.__desktop_rtn__ .ico_ks,.__tablet_rtn__ .ico_ks{background-image:url(./ico_ks_rtn.png);-webkit-background-size:500px 1000px;background-size:500px 1000px}.__desktop_rtn__ .ico_error,.__tablet_rtn__ .ico_error{background-image:url(./ico_error_rtn.png);-webkit-background-size:193px 480px;background-size:193px 480px}.head_story{position:fixed;z-index:100;width:100%;min-width:768px;height:64px;border-bottom:1px solid #d0d0d0;background-color:#fff}.head_story .tit_kakaostory{display:inline;float:left;margin:20px 0 0 16px}.head_story .link_logo{display:block;width:140px;height:27px;font-weight:700;font-size:24px;line-height:27px;background-position:0 0;color:#dd604a;letter-spacing:-1px;text-indent:0;text-decoration:none}#kakaoRelServices li{display:inline;float:left;margin-left:12px}.article_error{padding-top:65px}.error_wrap{position:absolute;left:0;top:65px;bottom:0;right:0;min-height:500px}.info_error{position:absolute;left:0;top:50%;width:100%;margin-top:-143px;text-align:center}.info_error .ico_exclamation{width:26px;height:90px;margin:0 auto;background-position:0 0}.info_error .tit_error{display:block;margin-top:53px;font-size:36px;color:#2b2c31}.info_error .desc_error{margin-top:7px;font-size:15px;line-height:20px;color:#63676f}.info_error .txt_error{display:block;width:388px;margin:15px auto 0;padding-top:19px;border-top:1px solid #d2d2d2;font-size:14px;color:#36373c}.btn_com{display:inline-block;border-width:1px;border-style:solid;border-radius:2px;text-align:center;text-decoration:none}.bn_group .btn_com{height:38px;margin:50px 0 0 0;padding:0 20px;font-weight:400;font-size:16px;line-height:38px}.bn_group .btn_wh{border-color:#d9d9d9;color:#999}#cMain h3{margin-top:40px}#cMain .info_error p{margin-top:10px;font-size:1.17em}#cMain .error_wrap{top:30px}</style><link rel="stylesheet" type="text/css" href="https://t1.kakaocdn.net/story_static/web/a66008078/desktop/css/common.css"><link rel="stylesheet" type="text/css" href="https://t1.kakaocdn.net/story_static/web/a66008078/desktop/css/common2.css"><body><div id="wrap"><div id="kakaoContent" class="cont_story"><div id="cMain"><div id="mArticle" class="article_error" role="main"><div class="error_wrap"><div class="info_error info_urlerror"><span class="ico_error ico_quotation"></span><h3 class="">OpenAPI를 이용한 카카오스토리로 공유하기 기능이 종료되었습니다.</h3><p>공유할 URL을 복사 후 카카오스토리에 직접 등록해 보세요.</p><div class="bn_group"><a href="https://story.kakao.com/" onclick="return window.close(),!1" class="_cancelBtn btn_com btn_wh" data-kant-id="491"><em>확인</em></a></div></div></div></div></div></div></div></body></head></html>